
#include <stdio.h>

int main() {
    int a[5][3] = {
        {1,1,0}, {1,1,1}, {1,0,1},
        {0,1,1}, {1,1,1}
    };
    int i, j, count;

    printf("Frequent Itemsets:\n");

    for(j = 0; j < 3; j++) {
        count = 0;
        for(i = 0; i < 5; i++)
            if(a[i][j] == 1)
                count++;

        if(count >= 3)
            printf("Item %c: Support = %d\n", 'A'+j, count);
    }

    return 0;
}
#output
Frequent Itemsets:
Item A: Support = 4
Item B: Support = 4
Item C: Support = 4
